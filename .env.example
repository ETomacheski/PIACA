# Postgres local (defaults ja existem no docker-compose, sobrescrever se quiser)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=piaca_db
DB_USER=piaca_user
DB_PASSWORD=piaca_pass

# JWT (obrigatorio para o piaca-core-auth subir)
# gerar com: openssl rand -base64 48
JWT_SECRET=troque-isso-por-um-segredo-aleatorio-longo
JWT_EXPIRES_IN=7d
